# Safe default: no paid calls. Copy to a local ignored .env; never commit credentials.
VERIFIER_MODE=mock
# To explicitly opt in later, use VERIFIER_MODE=deepseek and supply account settings.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Required in deepseek mode: fill the model ID enabled for your account.
DEEPSEEK_MODEL=
DEEPSEEK_TIMEOUT_SECONDS=30
